# Somos Comunidad - Root .htaccess (Site5 Production)
<IfModule mod_rewrite.c>
    RewriteEngine On

    # Pass Authorization header through to PHP
    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

    # Compatibility for live stack: one "api" segment is consumed upstream.
    # Force /api/foo to CI path /api/api/foo so backend resolves expected route.
    RewriteRule ^api/(.*)$ api/public/index.php/api/api/$1 [L,QSA]
    RewriteRule ^api$ api/public/index.php [L,QSA]

    # React SPA fallback — serve index.html for all non-file, non-dir routes
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^ index.html [L]
</IfModule>
